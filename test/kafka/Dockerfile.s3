# Dockerfile for building Hanzo components from the current workspace
FROM golang:1.26.5-alpine AS builder
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git make gcc musl-dev sqlite-dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -o /out/s3 ./s3

FROM alpine:latest

RUN apk --no-cache add ca-certificates curl wget netcat-openbsd sqlite

COPY --from=builder /out/s3 /usr/bin/s3

WORKDIR /data

EXPOSE 9333 19333 8080 18080 8888 18888 16777 17777

ENTRYPOINT ["/usr/bin/s3"]
