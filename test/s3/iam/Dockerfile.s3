# Multi-stage build for Hanzo S3 with IAM
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make curl wget

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Build Hanzo with IAM integration
RUN cd s3 && go build -o /usr/local/bin/s3

# Final runtime image
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates wget curl

# Copy s3 binary
COPY --from=builder /usr/local/bin/s3 /usr/local/bin/s3

# Create directories
RUN mkdir -p /etc/hanzo /data

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8333/ || exit 1

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/s3"]
