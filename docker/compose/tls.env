S3_GRPC_CA=/etc/hanzo/tls/S3_CA.crt
S3_GRPC_ALLOWED_WILDCARD_DOMAIN=".dev"
S3_GRPC_MASTER_CERT=/etc/hanzo/tls/master01.dev.crt
S3_GRPC_MASTER_KEY=/etc/hanzo/tls/master01.dev.key
S3_GRPC_VOLUME_CERT=/etc/hanzo/tls/volume01.dev.crt
S3_GRPC_VOLUME_KEY=/etc/hanzo/tls/volume01.dev.key
S3_GRPC_FILER_CERT=/etc/hanzo/tls/filer01.dev.crt
S3_GRPC_FILER_KEY=/etc/hanzo/tls/filer01.dev.key
S3_GRPC_CLIENT_CERT=/etc/hanzo/tls/client01.dev.crt
S3_GRPC_CLIENT_KEY=/etc/hanzo/tls/client01.dev.key
S3_GRPC_MASTER_ALLOWED_COMMONNAMES="volume01.dev,master01.dev,filer01.dev,client01.dev"
S3_GRPC_VOLUME_ALLOWED_COMMONNAMES="volume01.dev,master01.dev,filer01.dev,client01.dev"
S3_GRPC_FILER_ALLOWED_COMMONNAMES="volume01.dev,master01.dev,filer01.dev,client01.dev"
S3_GRPC_CLIENT_ALLOWED_COMMONNAMES="volume01.dev,master01.dev,filer01.dev,client01.dev"
S3_HTTPS_CLIENT_ENABLE=true
S3_HTTPS_VOLUME_CERT=/etc/hanzo/tls/volume01.dev.crt
S3_HTTPS_VOLUME_KEY=/etc/hanzo/tls/volume01.dev.key
S3_HTTPS_VOLUME_CA=/etc/hanzo/tls/S3_CA.crt
#GRPC_GO_LOG_SEVERITY_LEVEL=info
#GRPC_GO_LOG_VERBOSITY_LEVEL=2