# Dockerfile for Hanzo Mount with RDMA support
FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    fuse3 \
    curl \
    wget \
    ca-certificates \
    procps \
    util-linux \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /usr/local/bin /mnt/hanzo /var/log/hanzo

# Copy Hanzo binary (will be built from context)
COPY bin/s3 /usr/local/bin/s3
RUN chmod +x /usr/local/bin/s3

# Copy mount helper scripts
COPY scripts/mount-helper.sh /usr/local/bin/mount-helper.sh
RUN chmod +x /usr/local/bin/mount-helper.sh

# Create mount point
RUN mkdir -p /mnt/hanzo

# Set up FUSE permissions
RUN echo 'user_allow_other' >> /etc/fuse.conf

# Health check script
COPY scripts/mount-health-check.sh /usr/local/bin/mount-health-check.sh
RUN chmod +x /usr/local/bin/mount-health-check.sh

# Expose mount point as volume
VOLUME ["/mnt/hanzo"]

# Default command
CMD ["/usr/local/bin/mount-helper.sh"]
